---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title: string;
  /** Shown as a "back" link in the topbar, e.g. { href: "/books", label: "Shelf" }. */
  back?: { href: string; label: string };
  /** Extra class(es) for the <main> element — controls per-page layout (grid vs. block). */
  mainClass?: string;
}

const { title, back, mainClass = "layout" } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,500;1,400&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <div id="app">
      <header class="topbar">
        <a href="/" class="mark-link">
          <div class="mark">&#9670;</div>
        </a>
        <nav class="topnav">
          {back && (
            <a href={back.href} class="back-link">&larr; {back.label}</a>
          )}
        </nav>
      </header>

      <main class={mainClass}>
        <slot />
      </main>

      <footer class="foot">
        <span>A personal prototyping workbench &middot; built with Astro</span>
      </footer>
    </div>
  </body>
</html>
