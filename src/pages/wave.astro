---
import Base from "../layouts/Base.astro";
import WaveLab from "../components/WaveLab";
---

<Base title="Wave lab" back={{ href: "/", label: "Workbench" }} mainClass="layout-wave">
  <div class="wave-stage">
    <WaveLab client:only="react" />
  </div>
</Base>

<style>
  .layout-wave {
    display: block;
    max-width: none;
    padding: 0;
  }

  .wave-stage {
    width: 100%;
    height: calc(100vh - 140px);
  }

  .wave-stage :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }
</style>
